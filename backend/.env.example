# =============================================================================
# MARUDAM Backend — Environment Variables Template
# =============================================================================
# Instructions:
#   1. Copy this file to .env:
#      cp .env.example .env
#   2. Fill in your Supabase service-role key and device configuration.
#   3. NEVER commit your real .env file to version control.
# =============================================================================

# ── Supabase Cloud Database ──────────────────────────────────────────────────
# Obtain from: Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://your-project-id.supabase.co

# Service-Role Secret Key (SERVER-SIDE ONLY — bypasses RLS for sensor ingestion)
# NEVER expose this key to the frontend or git repository!
SUPABASE_SERVICE_ROLE_KEY=

# ── Device Identification ────────────────────────────────────────────────────
# MUST match the DEVICE_ID defined in esp32/include/config.h.
# IMPORTANT FOR MULTI-COMPUTER SETUP:
# If Computer 1 uses 'FIELD_001', Computer 2 MUST use a distinct identifier
# (e.g., 'FIELD_002') to prevent telemetry, baselines, and anomalies from clashing.
DEVICE_ID=FIELD_001

# ── Serial / USB Hardware Configuration ──────────────────────────────────────
# AUTO = Automatically scan and connect to the ESP32 (CP2102, CH340, FTDI)
# Or specify an explicit COM port on Windows: COM3, COM4, COM6, etc.
SERIAL_PORT=AUTO
SERIAL_BAUD=115200

# ── Mock Mode ────────────────────────────────────────────────────────────────
# Set to true to generate simulated two-field sensor data when no hardware is plugged in.
# MUST be false when running with real physical sensors!
MOCK_SERIAL=false

# ── Local Server Configuration ───────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# ── Optional: AI & Weather API Keys ──────────────────────────────────────────
# Used for downstream agro-diagnostic event explanations & weather data
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
WEATHER_API_KEY=

# ── Anomaly Thresholds (optional overrides) ──────────────────────────────────
# THRESHOLD_SOIL_MOISTURE=8.0
# THRESHOLD_SOIL_TEMPERATURE=5.0
# THRESHOLD_AIR_TEMPERATURE=15.0
# THRESHOLD_HUMIDITY=15.0
# THRESHOLD_LIGHT_LUX=50000.0
