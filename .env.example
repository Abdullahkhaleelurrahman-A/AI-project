# =============================================================================
# MARUDAM — Frontend (Next.js) Environment Template
# =============================================================================
# Instructions:
#   1. Copy this file to .env.local:
#      cp .env.example .env.local
#   2. Fill in your Supabase project credentials.
#   3. NEVER commit your real .env.local file to version control.
# =============================================================================

# ── Supabase Cloud Configuration ─────────────────────────────────────────────
# Obtain from: Supabase Dashboard > Project Settings > API
# URL: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Public anon / publishable key (safe for browser client-side use)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-anon-key

# ── Local Backend URL ─────────────────────────────────────────────────────────
# Used by the Next.js dashboard to poll real-time sensor updates from FastAPI
# Default: http://localhost:8000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# ── Optional: AI Chatbot & Weather API Keys ───────────────────────────────────
# Used server-side for the farm assistant chatbot & weather data
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash
WEATHER_API_KEY=

