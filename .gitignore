# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (allow safe .example templates)
.env*
!.env.example
!backend/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ESP32 local configuration — contains Wi-Fi credentials, NEVER commit
esp32/include/config.h
!esp32/include/config.h.example

# Python cache
**/__pycache__/
*.py[cod]
*$py.class
backend/sensors.db

# PlatformIO build artifacts
esp32/.pio/

# Python virtual environment
.venv/
backend/.venv/

# Archives
*.zip
*.tar.gz
